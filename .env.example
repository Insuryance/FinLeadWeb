# Local development environment for FinLeadWeb.
# Copy to .env.local and adjust. .env.local is gitignored.

# Anthropic key for the embedded assistant (app/api/copilot/route.js).
ANTHROPIC_API_KEY=

# Base URL of the FinLead grid-extraction trial API, consumed server-side by
# app/api/grid-trial/[...path]/route.js. The browser never sees this value.
#
#   local backend (finlead-backend ./run-backend.sh):
FINLEAD_GRID_API=http://localhost:5001/api/grid-trial/v1
#
#   deployed backend would be e.g.:
# FINLEAD_GRID_API=https://api.finlead.ai/api/grid-trial/v1
